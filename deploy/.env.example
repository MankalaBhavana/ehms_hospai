# Copy to deploy/.env and fill in. Never commit the real file.

# Database
POSTGRES_DB=hospai
POSTGRES_USER=hospai
POSTGRES_PASSWORD=                # required: long random password

# Backend secrets
SESSION_PEPPER=                   # required: random 32+ chars  (openssl rand -base64 32)
INITIAL_ADMIN_PASSWORD=           # required on first start: password for the "admin" account; change it after signing in
SESSION_TTL_HOURS=12

# Public address of the site (used in patient-card QR codes), e.g. https://ehms.example.org
PUBLIC_APP_URL=
WEB_PORT=8443
